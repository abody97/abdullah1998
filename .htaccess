# Security Configuration for Employee & Equipment Management System
# ولاء المستقبل للمقاولات - نظام إدارة الموظفين والمعدات

# Enable rewrite engine
RewriteEngine On

# IP Whitelisting - Replace with your actual office IP addresses
# قائمة عناوين IP المسموح لها بالوصول - استبدل بعناوين IP الفعلية للمكتب

# Example: Allow access only from specific IP addresses
# مثال: السماح بالوصول فقط من عناوين IP محددة

# Uncomment and modify the following lines with your actual IP addresses:
# ألغ التعليق وعدل الأسطر التالية بعناوين IP الفعلية:

# <RequireAll>
#     Require ip 192.168.1.100
#     Require ip 192.168.1.101
#     Require ip 10.0.0.50
#     # Add more IP addresses as needed
# </RequireAll>

# Alternative: Allow access only from local network
# بديل: السماح بالوصول فقط من الشبكة المحلية

# <RequireAll>
#     Require ip 192.168.1
#     Require ip 10.0.0
#     Require ip 172.16
# </RequireAll>

# Security Headers
# رؤوس الأمان

Header always set X-Frame-Options DENY
Header always set X-Content-Type-Options nosniff
Header always set X-XSS-Protection "1; mode=block"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; font-src 'self' https://cdnjs.cloudflare.com; img-src 'self' data:;"

# Disable directory browsing
# تعطيل تصفح المجلدات
Options -Indexes

# Protect sensitive files
# حماية الملفات الحساسة
<Files ~ "^\.">
    Order allow,deny
    Deny from all
</Files>

# Block access to backup files
# منع الوصول إلى ملفات النسخ الاحتياطي
<FilesMatch "\.(bak|backup|old|tmp|log)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Force HTTPS (uncomment if SSL is available)
# فرض استخدام HTTPS (ألغ التعليق في حالة توفر SSL)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Cache control for static files
# التحكم في التخزين المؤقت للملفات الثابتة
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpg "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/gif "access plus 1 month"
    ExpiresByType image/ico "access plus 1 month"
    ExpiresByType image/icon "access plus 1 month"
    ExpiresByType text/html "access plus 1 day"
</IfModule>

# Compress files for better performance
# ضغط الملفات لتحسين الأداء
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/xml
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE application/xml
    AddOutputFilterByType DEFLATE application/xhtml+xml
    AddOutputFilterByType DEFLATE application/rss+xml
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
</IfModule>